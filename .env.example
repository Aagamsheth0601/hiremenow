# Copy to .env and fill in. Never commit .env.

# --- Backend ---
DEBUG=false
DATABASE_URL=sqlite:///./hiremenow.db
FRONTEND_URL=http://localhost:5173

# OpenRouter — for resume parsing (free tier models supported, e.g. Llama 3.3 70B Instruct)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
RESUME_PARSER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Anthropic (optional — reserved for future features like outreach drafting)
ANTHROPIC_API_KEY=

# Google OAuth — for Gmail send permission
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Frontend ---
VITE_BACKEND_URL=http://127.0.0.1:8000
